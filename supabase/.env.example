# #region hook-env
# Local Supabase only: `supabase start` reads this file (copy it to supabase/.env) and fills the
# [auth.hook.before_user_created] block in config.toml. On hosted Supabase you paste the same two values in the
# dashboard instead: Authentication > Hooks > Before User Created > HTTPS.
SIGNUPBOUNCER_HOOK_URL=https://signupbouncer.com/hook/supabase/app_...
SIGNUPBOUNCER_HOOK_SECRET=v1,whsec_...
# #endregion
