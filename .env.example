# Next.js app: copy to .env.local. Values from `supabase status` (local) or your Supabase project's API settings.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only: gives a credit back when image generation fails.
SUPABASE_SECRET_KEY=sb_secret_...
# Optional. Without it the app returns a bundled sample image and still spends the credit.
REPLICATE_API_TOKEN=
